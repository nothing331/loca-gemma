# loca-gemma secrets template.
# Copy this file to `.env` and fill in real values, then `docker compose up -d`.
#
#   cp .env.example .env
#   # generate each value with:  openssl rand -hex 32
#
# `.env` is gitignored — never commit real secrets.

# SearXNG server secret. Injected into searxng/settings.yml at container start.
SEARXNG_SECRET=

# Open WebUI session/JWT signing key. Keep it stable so logins survive restarts.
WEBUI_SECRET_KEY=
